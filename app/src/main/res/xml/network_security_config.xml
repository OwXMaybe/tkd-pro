<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain HTTP is permitted at the platform level so the phone can reach TKD PRO running on the owner's
  computer over home Wi-Fi (e.g. http://192.168.1.20:8000). BackendClient.isAllowedUrl refuses plain HTTP
  to any public address: only loopback, private LAN ranges, Tailscale (100.64/10) and *.local are accepted.
  Map tiles and everything else use HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
