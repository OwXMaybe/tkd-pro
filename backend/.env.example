# --- Required -----------------------------------------------------------
# SHA-256 hex digest of the owner access token. Generate both with:
#   python -m app.cli new-token
# Put the printed token into the app (Settings > Owner backend) and the hash here.
OWNER_TOKEN_SHA256=

# PostgreSQL connection (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://tkdpro:change-me@localhost:5432/tkdpro

# --- Optional: AI Coach -------------------------------------------------
# Without a key, AI endpoints return 503 and the app shows "AI unavailable".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Optional: server video analysis -----------------------------------
# Requires requirements-motion.txt and the MediaPipe pose model file.
POSE_MODEL_PATH=./models/pose_landmarker_full.task
MAX_UPLOAD_MB=200
